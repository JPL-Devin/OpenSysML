model: cmd/pilot-exec-diff/testdata/models/value_classification.sysml

# `x @ T` on a value is the classification test `x istype T` (KerML
# ClassificationExpression): it holds for T and for every type T's value
# conforms to, where `hastype` holds for the value's direct type alone. The
# pilot cannot resolve ScalarValues names inside a bare %eval, so each case
# reads a model-level attribute bound to the expression.
at-integer ::  :: Classify::atInteger
at-real ::  :: Classify::atReal
at-string ::  :: Classify::atString
real-at-integer ::  :: Classify::realAtInteger
seq-at-integer ::  :: Classify::seqAtInteger
car-at-car ::  :: Classify::carAtCar
car-at-vehicle ::  :: Classify::carAtVehicle
hastype-integer ::  :: Classify::hasInteger
hastype-real ::  :: Classify::hasReal
istype-real ::  :: Classify::isReal
