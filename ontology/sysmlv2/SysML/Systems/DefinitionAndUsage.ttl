    rdfs:domain sysml:Usage ;
    rdfs:range sysml:EnumerationUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedEnumeration" ;
    rdfs:comment "<p>The code>EnumerationUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.<p>" .

sysml:Usage_nestedFlow
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedConnection ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:FlowConnectionUsage ;
    rdfs:label "nestedFlow" ;
    rdfs:comment "<p>The code>FlowConnectionUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedInterface
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedConnection ;
