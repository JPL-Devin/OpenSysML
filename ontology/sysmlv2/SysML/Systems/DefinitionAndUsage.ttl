    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedUsage ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:AttributeUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedAttribute" ;
    rdfs:comment "<p>The code>AttributeUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

