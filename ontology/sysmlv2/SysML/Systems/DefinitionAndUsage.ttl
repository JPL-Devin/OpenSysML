    rdfs:domain sysml:Usage ;
    rdfs:range sysml:AnalysisCaseUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedAnalysisCase" ;
    rdfs:comment "<p>The <code>AnalysisCaseUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

