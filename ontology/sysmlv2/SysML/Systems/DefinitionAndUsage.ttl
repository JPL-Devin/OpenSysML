sysml:Usage_nestedItem
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedOccurrence ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:ItemUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedItem" ;
    rdfs:comment "<p>The <code>ItemUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedMetadata
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedItem ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:MetadataUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedMetadata" ;
    rdfs:comment "<p>The <code>MetadataUsages</code> that are <code>nestedUsages</code> of this of this <code>Usage</code>.</p>" .

sysml:Usage_nestedOccurrence
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedUsage ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:OccurrenceUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedOccurrence" ;
    rdfs:comment "<p>The <code>OccurrenceUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedPart
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedItem ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:PartUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedPart" ;
    rdfs:comment "<p>The <code>PartUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedPort
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedUsage ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:PortUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedPort" ;
    rdfs:comment "<p>The <code>PortUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedReference
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedUsage ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:ReferenceUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedReference" ;
    rdfs:comment "<p>The <code>ReferenceUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedRendering
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedPart ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:RenderingUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedRendering" ;
    rdfs:comment "<p>The <code>RenderingUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedRequirement
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedConstraint ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:RequirementUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedRequirement" ;
    rdfs:comment "<p>The <code>RequirementUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedState
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedAction ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:StateUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedState" ;
    rdfs:comment "<p>The <code>StateUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedTransition
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedUsage ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:TransitionUsage ;
    rdfs:label "nestedTransition" ;
    rdfs:comment "<p>The <code>TransitionUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedUsage
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Type_ownedFeature, sysml:Usage_usage ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:Usage ;
    ecore:isOrdered true ;
    rdfs:label "nestedUsage" ;
    rdfs:comment "<p>The <code>Usages</code> that are <code>ownedFeatures</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedUseCase
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedCase ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:UseCaseUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedUseCase" ;
    rdfs:comment "<p>The <code>UseCaseUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedVerificationCase
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedCase ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:VerificationCaseUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedVerificationCase" ;
    rdfs:comment "<p>The <code>VerificationCaseUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedView
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedPart ;
    rdfs:domain sysml:Usage ;
    rdfs:range sysml:ViewUsage ;
    ecore:isOrdered true ;
    rdfs:label "nestedView" ;
    rdfs:comment "<p>The <code>ViewUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p>" .

sysml:Usage_nestedViewpoint
    a owl:ObjectProperty ;
    rdfs:subPropertyOf sysml:Usage_nestedRequirement ;
    rdfs:domain sysml:Usage ;
