@prefix elmt: <urn:sysmlv2:element:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sysml: <https://www.omg.org/spec/SysML#> .
@prefix sysx: <urn:systemica:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Relations
    a sysml:Package ;
    sysml:qualifiedName "Relations" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Relations" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Relations::Base
    a sysml:PartDefinition ;
    sysml:qualifiedName "Relations::Base" ;
    sysml:owningNamespace elmt:Relations ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Base" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Relations::Sub
    a sysml:PartDefinition ;
    sysml:qualifiedName "Relations::Sub" ;
    sysml:owningNamespace elmt:Relations ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "Sub" ;
    sysml:specializes elmt:Relations::Base ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Relations::Other
    a sysml:PartDefinition ;
    sysml:qualifiedName "Relations::Other" ;
    sysml:owningNamespace elmt:Relations ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "Other" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Relations::Other::b
    a sysml:PartUsage ;
    sysml:qualifiedName "Relations::Other::b" ;
    sysml:owningNamespace elmt:Relations::Other ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "b" ;
    sysml:type elmt:Relations::Base ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Relations::Other::r
    a sysml:PartUsage ;
    sysml:qualifiedName "Relations::Other::r" ;
    sysml:owningNamespace elmt:Relations::Other ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "r" ;
    sysml:redefines elmt:Relations::Other::b ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Relations::Other::s
    a sysml:PartUsage ;
    sysml:qualifiedName "Relations::Other::s" ;
    sysml:owningNamespace elmt:Relations::Other ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "s" ;
    sysml:subsets elmt:Relations::Other::b ;
    sysx:hasBody "false"^^xsd:boolean .
