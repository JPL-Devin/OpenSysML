@prefix elmt: <urn:sysmlv2:element:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sysml: <https://www.omg.org/spec/SysML#> .
@prefix sysx: <urn:opensysml:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Modifiers
    a sysml:Package ;
    sysml:qualifiedName "Modifiers" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Modifiers" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Modifiers__Hidden
    a sysml:PartDefinition ;
    sysml:qualifiedName "Modifiers::Hidden" ;
    sysml:owningNamespace elmt:Modifiers ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:visibility "private" ;
    sysml:declaredName "Hidden" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Modifiers__Shown
    a sysml:PartDefinition ;
    sysml:qualifiedName "Modifiers::Shown" ;
    sysml:owningNamespace elmt:Modifiers ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:visibility "public" ;
    sysml:declaredName "Shown" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Modifiers__Base
    a sysml:PartDefinition ;
    sysml:qualifiedName "Modifiers::Base" ;
    sysml:owningNamespace elmt:Modifiers ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "Base" ;
    sysml:isAbstract "true"^^xsd:boolean ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Modifiers__Derived
    a sysml:PartDefinition ;
    sysml:qualifiedName "Modifiers::Derived" ;
    sysml:owningNamespace elmt:Modifiers ;
    sysx:memberIndex "3"^^xsd:integer ;
    sysml:declaredName "Derived" ;
    sysml:specializes elmt:Modifiers__Base ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Modifiers__Choice
    a sysml:PartDefinition ;
    sysml:qualifiedName "Modifiers::Choice" ;
    sysml:owningNamespace elmt:Modifiers ;
    sysx:memberIndex "4"^^xsd:integer ;
    sysml:declaredName "Choice" ;
    sysml:isVariation "true"^^xsd:boolean ;
    sysx:hasBody "false"^^xsd:boolean .
