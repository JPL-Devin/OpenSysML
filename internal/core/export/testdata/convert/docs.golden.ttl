@prefix sysx: <urn:opensysml:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Documented
    a sysml:Package ;
    sysml:qualifiedName "Documented" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Documented" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Documented___400
    a sysml:Documentation ;
    sysml:qualifiedName "Documented::@0" ;
    sysml:owningNamespace elmt:Documented ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:body " what this package is for " .

elmt:Documented__Wheel
    a sysml:PartDefinition ;
    sysml:qualifiedName "Documented::Wheel" ;
    sysml:owningNamespace elmt:Documented ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "Wheel" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Documented__Wheel___400
    a sysml:Documentation ;
    sysml:qualifiedName "Documented::Wheel::@0" ;
    sysml:owningNamespace elmt:Documented__Wheel ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:body " one wheel " .

elmt:Documented___402
    a sysml:Comment ;
    sysml:qualifiedName "Documented::@2" ;
    sysml:owningNamespace elmt:Documented ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:annotatedElement elmt:Documented__Wheel ;
