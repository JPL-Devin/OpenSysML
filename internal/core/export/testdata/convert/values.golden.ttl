@prefix elmt: <urn:sysmlv2:element:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sysml: <https://www.omg.org/spec/SysML#> .
@prefix sysx: <urn:systemica:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Values
    a sysml:Package ;
    sysml:qualifiedName "Values" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Values" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Values::Total
    a sysml:CalculationDefinition ;
    sysml:qualifiedName "Values::Total" ;
    sysml:owningNamespace elmt:Values ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Total" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Values::Total::x
    a sysml:AttributeUsage ;
    sysml:qualifiedName "Values::Total::x" ;
    sysml:owningNamespace elmt:Values::Total ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "x" ;
    sysml:direction "in" ;
    sysml:type "Real" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Values::Total::y
    a sysml:AttributeUsage ;
    sysml:qualifiedName "Values::Total::y" ;
    sysml:owningNamespace elmt:Values::Total ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "y" ;
    sysml:direction "in" ;
    sysml:type "Real" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Values::Total::result
    a sysml:AttributeUsage ;
    sysml:qualifiedName "Values::Total::result" ;
    sysml:owningNamespace elmt:Values::Total ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "result" ;
    sysml:isResult "true"^^xsd:boolean ;
    sysml:direction "out" ;
    sysml:type "Real" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Values::Sized
    a sysml:PartDefinition ;
    sysml:qualifiedName "Values::Sized" ;
    sysml:owningNamespace elmt:Values ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "Sized" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Values::Sized::size
    a sysml:AttributeUsage ;
    sysml:qualifiedName "Values::Sized::size" ;
    sysml:owningNamespace elmt:Values::Sized ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "size" ;
    sysml:type "Real" ;
    sysml:value "4.5" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Values::Sized::label
    a sysml:AttributeUsage ;
    sysml:qualifiedName "Values::Sized::label" ;
    sysml:owningNamespace elmt:Values::Sized ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "label" ;
    sysml:type "String" ;
    sysml:value "\"front\"" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Values::Sized::total
    a sysml:AttributeUsage ;
    sysml:qualifiedName "Values::Sized::total" ;
    sysml:owningNamespace elmt:Values::Sized ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "total" ;
    sysml:type "Real" ;
    sysml:value "1.0 + 2.0" ;
    sysx:hasBody "false"^^xsd:boolean .
