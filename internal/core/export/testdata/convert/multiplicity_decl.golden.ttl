elmt:Mult__single
    a sysx:MultiplicityDeclaration ;
    sysml:qualifiedName "Mult::single" ;
    sysml:owningNamespace elmt:Mult ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "single" ;
    sysml:subsets elmt:Mult__exactlyOne ;
    sysx:hasBody "false"^^xsd:boolean .
