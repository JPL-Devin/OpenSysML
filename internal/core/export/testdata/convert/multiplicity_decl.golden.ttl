@prefix sysx: <urn:opensysml:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Mult
    a sysml:Package ;
    sysml:qualifiedName "Mult" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Mult" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Mult__exactlyOne
    a sysx:MultiplicityDeclaration ;
    sysml:qualifiedName "Mult::exactlyOne" ;
    sysml:owningNamespace elmt:Mult ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "exactlyOne" ;
    sysml:lowerBound expr:Mult__exactlyOne.lowerBound ;
    sysml:upperBound expr:Mult__exactlyOne.upperBound ;
    sysx:hasBody "false"^^xsd:boolean .

expr:Mult__exactlyOne.lowerBound
    a sysml:LiteralInteger ;
    sysx:sourceText "1" ;
    sysml:value "1"^^xsd:integer .

expr:Mult__exactlyOne.upperBound
    a sysml:LiteralInteger ;
    sysx:sourceText "1" ;
    sysml:value "1"^^xsd:integer .

elmt:Mult__optional
    a sysx:MultiplicityDeclaration ;
    sysml:qualifiedName "Mult::optional" ;
    sysml:owningNamespace elmt:Mult ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "optional" ;
    sysml:lowerBound expr:Mult__optional.lowerBound ;
    sysml:upperBound expr:Mult__optional.upperBound ;
    sysx:hasBody "false"^^xsd:boolean .

expr:Mult__optional.lowerBound
    a sysml:LiteralInteger ;
