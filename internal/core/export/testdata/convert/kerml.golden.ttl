@prefix elmt: <urn:sysmlv2:element:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sysml: <https://www.omg.org/spec/SysML#> .
@prefix sysx: <urn:opensysml:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Structural
    a sysml:Package ;
    sysml:qualifiedName "Structural" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Structural" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Structural__Frame
    a sysml:Structure ;
    sysml:qualifiedName "Structural::Frame" ;
    sysml:owningNamespace elmt:Structural ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Frame" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Structural__Move
    a sysml:Behavior ;
    sysml:qualifiedName "Structural::Move" ;
    sysml:owningNamespace elmt:Structural ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "Move" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Structural__Thing
    a sysml:Class ;
    sysml:qualifiedName "Structural::Thing" ;
    sysml:owningNamespace elmt:Structural ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "Thing" ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Structural__Link
    a sysml:Association ;
    sysml:qualifiedName "Structural::Link" ;
    sysml:owningNamespace elmt:Structural ;
    sysx:memberIndex "3"^^xsd:integer ;
