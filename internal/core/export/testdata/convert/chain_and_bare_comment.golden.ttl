    sysml:type elmt:Chains::V ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Chains::Named
    a sysml:Comment ;
    sysml:qualifiedName "Chains::Named" ;
    sysml:owningNamespace elmt:Chains ;
    sysx:memberIndex "4"^^xsd:integer ;
    sysml:declaredName "Named" ;
    sysml:annotatedElement elmt:Chains::V ;
    sysml:body " a comment that is identified " .
