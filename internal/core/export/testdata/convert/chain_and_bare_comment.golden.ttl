@prefix sysx: <urn:opensysml:sysml:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

elmt:Chains
    a sysml:Package ;
    sysml:qualifiedName "Chains" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "Chains" ;
    sysx:hasBody "true"^^xsd:boolean .

<urn:sysmlv2:element:Chains::@0>
    a sysml:Comment ;
    sysml:qualifiedName "Chains::@0" ;
    sysml:owningNamespace elmt:Chains ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:body " a comment with no name and no about clause " .

elmt:Chains::V
    a sysml:PartDefinition ;
    sysml:qualifiedName "Chains::V" ;
    sysml:owningNamespace elmt:Chains ;
    sysx:memberIndex "1"^^xsd:integer ;
    sysml:declaredName "V" ;
    sysx:hasBody "true"^^xsd:boolean .

elmt:Chains::V::e
    a sysml:PartUsage ;
    sysml:qualifiedName "Chains::V::e" ;
    sysml:owningNamespace elmt:Chains::V ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:declaredName "e" ;
    sysml:type elmt:Chains::V ;
    sysx:hasBody "false"^^xsd:boolean .

elmt:Chains::v
    a sysml:PartUsage ;
    sysml:qualifiedName "Chains::v" ;
    sysml:owningNamespace elmt:Chains ;
    sysx:memberIndex "2"^^xsd:integer ;
    sysml:declaredName "v" ;
