%% FlowViews::driveView — action rendering (render asInterconnectionDiagram, view def ActionFlowView)
flowchart TD
  subgraph n0 ["action def Flows::Drive"]
    n1["initial start"]
    n2["action provide"]
    subgraph n3 ["action monitor (own flow)"]
      n5["initial begin"]
      n6["action record"]
    end
    n7["fork split"]
    n8["join sync"]
    n9["final done"]
    n10["action park"]
    n11["decision check"]
  end
  n5 --> n6
  n1 --> n7
  n2 --> n8
  n2 -.->|"torque to reading"| n3
  n3 --> n8
  n7 --> n2
  n7 --> n3
  n8 --> n11
  n10 --> n9
  n11 -->|"[speed #gt; 0]"| n9
  n11 --> n10
