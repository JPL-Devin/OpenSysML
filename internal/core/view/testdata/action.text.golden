FlowViews::driveView - action rendering (render asInterconnectionDiagram, view def ActionFlowView)

action def Flows::Drive
  initial start
  action provide
  action monitor (own flow)
    initial begin
    action record
  fork split
  join sync
  final done
  action park
  decision check

flow:
  begin -> record
  start -> split
  provide -> sync
  provide => monitor: torque to reading
  monitor -> sync
  split -> provide
  split -> monitor
  sync -> check
  park -> done
  check -> done: [speed > 0]
  check -> park
